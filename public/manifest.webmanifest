{
  "name": "Strudel Scrapbook",
  "short_name": "Scrapbook",
  "description": "A keyboard-driven library of Strudel code snippets with drum grids, piano rolls and playback.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#17122a",
